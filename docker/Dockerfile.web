# Rental Solutions Web Frontend Dockerfile
# Multi-stage build with nginx for production

# Build stage
FROM node:18-alpine AS builder

# Build arguments
ARG NODE_ENV=production
ARG BUILD_DATE
ARG VCS_REF

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Install security updates
RUN apk update && apk upgrade && apk add --no-cache \
    curl \
    && rm -rf /var/cache/apk/*

# Copy built application
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration for Arabic/RTL support
COPY docker/nginx-arabic.conf /etc/nginx/conf.d/arabic.conf

# Create nginx user
RUN addgroup -g 101 nginx
RUN adduser -D -S -u 101 -G nginx nginx

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d
RUN chmod -R 755 /usr/share/nginx/html

# Set environment variables
ENV TZ=Asia/Qatar

# Add metadata labels
LABEL maintainer="Rental Solutions DevOps <devops@rental-solutions.com>"
LABEL version="1.0.0"
LABEL description="Rental Solutions Web Frontend"
LABEL build-date=$BUILD_DATE
LABEL vcs-ref=$VCS_REF
LABEL vcs-url="https://github.com/rental-solutions/platform"

# Switch to non-root user
USER nginx

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"] 