# Environment Variables Template
# نسخ هذا الملف إلى .env وملء القيم الحقيقية

# ===== Google Vision API =====
# مفتاح Google Vision API للتعرف على النصوص في الصور
# احصل على المفتاح من: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ===== OpenAI API =====
# مفتاح OpenAI API (ChatGPT) لتحليل النصوص
# احصل على المفتاح من: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ===== Supabase Configuration =====
# بيانات قاعدة البيانات Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== Application Settings =====
# إعدادات التطبيق الأساسية
VITE_APP_NAME="العراف لتأجير السيارات"
VITE_APP_VERSION=1.0.0

# ===== Production Only =====
# متغيرات خاصة بالإنتاج (لا تضعها في التطوير)
# VITE_PRODUCTION_MODE=true
# VITE_ANALYTICS_ID=your_analytics_id

# ملاحظات هامة:
# 1. لا تضع هذا الملف (.env) في Git - فقط .env.example
# 2. في البيئة التجريبية: انسخ .env.example إلى .env وضع المفاتيح التجريبية
# 3. في الإنتاج: استخدم خدمة إدارة المتغيرات مثل Vercel Environment Variables
# 4. تأكد من حماية المفاتيح وعدم مشاركتها مع أحد 