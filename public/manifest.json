{
  "name": "Al-Araf Car Rental Management System",
  "short_name": "Al-Araf Rental",
  "description": "Complete car rental management system with agreements, payments, maintenance tracking, and legal document generation",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#1e40af",
  "background_color": "#ffffff",
  "dir": "auto",
  "lang": "en",
  "categories": ["business", "productivity", "finance"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "New Agreement",
      "short_name": "Agreement",
      "description": "Create a new rental agreement",
      "url": "/agreements/new",
      "icons": [{ "src": "/icons/agreement-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Payments",
      "short_name": "Payments",
      "description": "View and manage payments",
      "url": "/payments",
      "icons": [{ "src": "/icons/payment-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vehicles",
      "short_name": "Vehicles", 
      "description": "Manage vehicle fleet",
      "url": "/vehicles",
      "icons": [{ "src": "/icons/vehicle-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Legal Letters",
